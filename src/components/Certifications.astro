---
import {
  getCertificationsData,
  useTranslations,
  type Locale,
  DEFAULT_LOCALE,
} from '../lib/i18n';
import { withBase } from '../lib/assetPath';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

const certificationsData = getCertificationsData(lang);
const t = useTranslations(lang);

const PAGE_SIZE = 3;

const certificates = certificationsData.map((cert, index) => ({
  ...cert,
  index,
  image: withBase(cert.image),
}));

const totalPages = Math.ceil(certificates.length / PAGE_SIZE);
const pages = Array.from({ length: totalPages }, (_, pageIndex) =>
  certificates.slice(pageIndex * PAGE_SIZE, (pageIndex + 1) * PAGE_SIZE)
);

const certsJson = JSON.stringify(certificates);
---

<section id="certifications" class="pt-6 pb-20 sm:pt-8 sm:pb-24" style="background: var(--bg-section); scroll-margin-top: 64px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-8 sm:mb-10 reveal">
      <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-2">
        {t.certsEyebrow}
      </p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">
        {t.certsTitle}
      </h2>
    </div>

    <!-- Carousel Viewport (Páginas de 3 certificados) -->
    <div class="max-w-6xl mx-auto certs-carousel-viewport">
      <div
        id="certs-track"
        class="certs-track"
      >
        {
          pages.map((pageCerts, pageIndex) => (
            <div
              class="cert-page-slide"
              data-page-slide={pageIndex}
            >
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 items-stretch w-full">
                {
                  pageCerts.map((cert, i) => (
                    <article
                      class="cert-card-v reveal"
                      data-cert-index={cert.index}
                      role="button"
                      tabindex="0"
                      aria-label={`${t.cardVerify}: ${cert.name}`}
                      style={`transition-delay: ${i * 0.1}s;`}
                    >
                      <!-- Certificate Media Preview -->
                      <div class="cert-card-media">
                        <img
                          src={cert.image}
                          alt={`${t.cardVerify}: ${cert.name}`}
                          loading="lazy"
                          class="cert-card-img"
                          width="480"
                          height="360"
                        />
                        <div class="cert-card-media-overlay">
                          <span class="cert-card-zoom-hint">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                            </svg>
                            {t.cardVerify}
                          </span>
                        </div>
                      </div>

                      <!-- Certificate Details -->
                      <div class="cert-card-body">
                        <div class="flex items-center justify-between gap-2 mb-1.5">
                          <span class="cert-issuer-badge">{cert.issuer}</span>
                          <span class="cert-date-text">{cert.date}</span>
                        </div>

                        <h3 class="cert-card-title text-base sm:text-lg font-bold mb-1.5 leading-snug">
                          {cert.name}
                        </h3>

                        <p class="cert-card-desc text-xs sm:text-sm leading-relaxed mb-3 line-clamp-2">
                          {cert.description}
                        </p>

                        <div class="cert-card-footer mt-auto pt-2.5">
                          <div class="flex flex-wrap gap-1.5">
                            {cert.skills.slice(0, 3).map((skill: string) => (
                              <span class="tag cert-skill-tag">{skill}</span>
                            ))}
                            {cert.skills.length > 3 && (
                              <span class="tag cert-skill-tag text-accent font-bold">+{cert.skills.length - 3}</span>
                            )}
                          </div>
                        </div>
                      </div>
                    </article>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>

      <!-- Pagination Controls -->
      <div class="certs-pagination-bar mt-3.5 sm:mt-4 reveal" aria-label={lang === 'es' ? 'Navegación de páginas de certificados' : 'Certificates page navigation'}>
        <button
          id="cert-prev-btn"
          class="cert-nav-arrow"
          aria-label={lang === 'es' ? 'Página anterior' : 'Previous page'}
          title={lang === 'es' ? 'Anterior' : 'Previous'}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="flex items-center gap-2" id="cert-page-buttons">
          {
            pages.map((_, i) => (
              <button
                class={`cert-page-btn ${i === 0 ? 'active' : ''}`}
                data-page-index={i}
                aria-label={lang === 'es' ? `Ir a la página ${i + 1}` : `Go to page ${i + 1}`}
              >
                {i + 1}
              </button>
            ))
          }
        </div>

        <button
          id="cert-next-btn"
          class="cert-nav-arrow"
          aria-label={lang === 'es' ? 'Página siguiente' : 'Next page'}
          title={lang === 'es' ? 'Siguiente' : 'Next'}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Certificate Official View Modal -->
<div
  id="cert-modal"
  class="cert-modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cert-modal-title"
  hidden
>
  <div class="cert-modal-container" id="cert-modal-container">
    <button class="cert-modal-close" id="cert-modal-close" aria-label={t.modalClose}>
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="cert-modal-grid">
      <!-- Full Official Certificate Preview Image -->
      <div class="cert-modal-image-wrap">
        <img
          id="cert-modal-img"
          src=""
          alt={t.cardVerifiedBadge}
          class="cert-modal-img"
          loading="lazy"
        />
        <div class="cert-modal-image-shine"></div>
      </div>

      <!-- Certificate Details & Verification Action -->
      <div class="cert-modal-content">
        <div class="flex items-center justify-between gap-3 mb-3">
          <span id="cert-modal-issuer" class="cert-issuer-badge"></span>
        </div>

        <h3 id="cert-modal-title" class="text-2xl sm:text-3xl font-extrabold text-white mb-3 leading-snug"></h3>
        
        <div class="flex items-center gap-3 text-sm text-slate-300 mb-4 font-mono">
          <span id="cert-modal-date"></span>
          <span>•</span>
          <span id="cert-modal-hours" class="text-highlight font-semibold"></span>
        </div>

        <div id="cert-modal-id-wrap" class="hidden mb-4 text-xs sm:text-sm font-mono bg-slate-900/90 border border-slate-700/60 rounded-xl px-4 py-2.5 flex items-center justify-between">
          <span class="text-slate-400 font-semibold">{t.cardId}:</span>
          <span id="cert-modal-id" class="text-accent font-bold select-all ml-2 tracking-wide font-mono"></span>
        </div>

        <p id="cert-modal-desc" class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6"></p>

        <h4 class="text-xs sm:text-sm font-bold text-highlight uppercase tracking-wider mb-2.5">
          {t.cardSkills}
        </h4>
        <div id="cert-modal-skills" class="flex flex-wrap gap-2 mb-8"></div>

        <div class="cert-modal-actions mt-auto pt-5 border-t border-slate-700/50 flex flex-col sm:flex-row gap-3">
          <a
            id="cert-modal-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="cert-verify-btn"
          >
            <span>{t.cardVerify}</span>
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <a
            id="cert-modal-view-full"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="cert-view-full-btn"
            title={lang === 'es' ? 'Abrir imagen de certificado a resolución completa' : 'Open certificate image at full resolution'}
          >
            <span>{lang === 'es' ? 'Ver Certificado Completo' : 'View Full Certificate'}</span>
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ certsJson, datePrefix: lang === 'es' ? 'Fecha: ' : 'Date: ', hoursPrefix: lang === 'es' ? 'Dedicación: ' : 'Hours: ' }}>
  // @ts-nocheck
  const certs = JSON.parse(certsJson);

  // Reveal animations
  document.querySelectorAll('#certifications .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.05 }
    );
    io.observe(el);
  });

  // Modal logic
  const modal = document.getElementById('cert-modal');
  const container = document.getElementById('cert-modal-container');
  const closeBtn = document.getElementById('cert-modal-close');
  const modalImg = document.getElementById('cert-modal-img');
  const modalIssuer = document.getElementById('cert-modal-issuer');
  const modalTitle = document.getElementById('cert-modal-title');
  const modalDate = document.getElementById('cert-modal-date');
  const modalHours = document.getElementById('cert-modal-hours');
  const modalIdWrap = document.getElementById('cert-modal-id-wrap');
  const modalId = document.getElementById('cert-modal-id');
  const modalDesc = document.getElementById('cert-modal-desc');
  const modalSkills = document.getElementById('cert-modal-skills');
  const modalLink = document.getElementById('cert-modal-link');
  const modalViewFull = document.getElementById('cert-modal-view-full');

  function openCertModal(idx) {
    const cert = certs[idx];
    if (!cert) return;

    modalImg.src = cert.image;
    modalImg.alt = cert.name;
    modalIssuer.textContent = cert.issuer;
    modalTitle.textContent = cert.name;
    modalDate.textContent = `${datePrefix}${cert.date}`;
    modalHours.textContent = `${hoursPrefix}${cert.hours}`;
    modalDesc.textContent = cert.description;

    if (cert.credentialId) {
      modalId.textContent = cert.credentialId;
      modalIdWrap.classList.remove('hidden');
    } else {
      modalIdWrap.classList.add('hidden');
    }

    modalSkills.innerHTML = '';
    for (const skill of cert.skills || []) {
      const span = document.createElement('span');
      span.className = 'cert-modal-skill-tag';
      span.textContent = skill;
      modalSkills.appendChild(span);
    }

    if (cert.credentialUrl) {
      modalLink.href = cert.credentialUrl;
      modalLink.classList.remove('hidden');
    } else {
      modalLink.classList.add('hidden');
    }

    if (modalViewFull) {
      modalViewFull.href = cert.image;
    }

    modal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    void container.offsetWidth;
    modal.classList.add('modal-open');
    closeBtn.focus();
  }

  function closeCertModal() {
    modal.classList.remove('modal-open');
    modal.classList.add('modal-closing');
    setTimeout(() => {
      modal.setAttribute('hidden', '');
      modal.classList.remove('modal-closing');
      document.body.style.overflow = '';
    }, 280);
  }

  const cards = document.querySelectorAll('.cert-card-v');
  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const idx = parseInt(card.dataset.certIndex, 10);
      openCertModal(idx);
    });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const idx = parseInt(card.dataset.certIndex, 10);
        openCertModal(idx);
      }
    });
  });

  closeBtn.addEventListener('click', closeCertModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeCertModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hasAttribute('hidden')) closeCertModal();
  });

  // Page Slider logic (Páginas de 3 certificados)
  const track = document.getElementById('certs-track');
  const pageButtons = document.querySelectorAll('.cert-page-btn');
  const prevBtn = document.getElementById('cert-prev-btn');
  const nextBtn = document.getElementById('cert-next-btn');
  const totalPages = pageButtons.length;
  let currentPage = 0;

  function setPage(idx) {
    if (totalPages <= 1) return;
    if (idx < 0) idx = totalPages - 1;
    if (idx >= totalPages) idx = 0;
    currentPage = idx;

    track.style.transform = `translateX(-${currentPage * 100}%)`;

    pageButtons.forEach((btn, i) => {
      btn.classList.toggle('active', i === currentPage);
    });

    // Asegurar que las tarjetas de la página activa sean visibles
    const activeSlide = track.querySelector(`[data-page-slide="${currentPage}"]`);
    if (activeSlide) {
      activeSlide.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
    }
  }

  pageButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.dataset.pageIndex, 10);
      setPage(idx);
    });
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      setPage(currentPage - 1);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      setPage(currentPage + 1);
    });
  }

  // Touch swipe support
  let touchStartX = 0;
  if (track) {
    track.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    track.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) setPage(currentPage + 1);
        else setPage(currentPage - 1);
      }
    }, { passive: true });
  }

  // Initial alignment
  setTimeout(() => setPage(0), 50);
</script>

<style is:global>
  /* Carousel Viewport */
  .certs-carousel-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 0.25rem 0.25rem 0.25rem;
  }

  .certs-track {
    display: flex;
    width: 100%;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
    align-items: stretch;
  }

  .cert-page-slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
    box-sizing: border-box;
    padding: 0.25rem;
  }

  /* Certificate Card */
  .cert-card-v {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .cert-card-v:hover,
  .cert-card-v.active-highlight {
    transform: translateY(-6px);
    border-color: rgba(0, 229, 255, 0.45);
    box-shadow:
      0 16px 40px -10px rgba(0, 0, 0, 0.5),
      0 0 25px -5px rgba(0, 229, 255, 0.2);
  }

  .cert-card-v:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Photo on Top */
  .cert-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #020617;
  }

  .cert-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cert-card-v:hover .cert-card-img {
    transform: scale(1.05);
  }

  .cert-card-media-overlay {
    position: absolute;
    inset: 0;
    background: rgba(2, 6, 23, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(2px);
  }

  .cert-card-v:hover .cert-card-media-overlay {
    opacity: 1;
  }

  .cert-card-zoom-hint {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
    background: rgba(2, 132, 199, 0.9);
    border: 1px solid rgba(0, 229, 255, 0.4);
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    transform: translateY(6px);
    transition: transform 0.3s ease;
  }

  .cert-card-v:hover .cert-card-zoom-hint {
    transform: translateY(0);
  }

  /* Body */
  .cert-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1rem 1.25rem;
  }


  .cert-card-title {
    color: var(--text);
    transition: color 0.25s ease;
  }
  .cert-card-v:hover .cert-card-title {
    color: var(--accent);
  }

  .cert-card-desc {
    color: var(--text-muted);
  }

  .cert-card-footer {
    border-top: 1px solid var(--border);
  }

  .cert-issuer-badge {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(0, 229, 255, 0.1);
    border: 1px solid rgba(0, 229, 255, 0.25);
    border-radius: 9999px;
    padding: 0.2rem 0.65rem;
    line-height: 1.2;
  }

  .cert-date-text {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-dimmer);
    font-family: ui-monospace, monospace;
  }

  .cert-skill-tag {
    font-size: 0.68rem;
    font-weight: 600;
    color: #7dd3fc;
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid rgba(0, 229, 255, 0.25);
    border-radius: 9999px;
    padding: 0.2rem 0.6rem;
    line-height: 1.2;
    transition: all 0.2s ease;
  }
  .cert-skill-tag:hover {
    color: #ffffff;
    background: rgba(0, 229, 255, 0.2);
    border-color: rgba(0, 229, 255, 0.5);
  }
  .cert-skill-tag.text-accent {
    color: #38bdf8;
    background: rgba(0, 229, 255, 0.15);
    border-color: rgba(0, 229, 255, 0.4);
  }

  /* Pagination Controls */
  .certs-pagination-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .cert-nav-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 0.65rem;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .cert-nav-arrow:hover {
    color: var(--text);
    border-color: var(--accent);
    background: rgba(0, 229, 255, 0.1);
    transform: translateY(-1px);
  }

  .cert-page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border-radius: 0.65rem;
    font-family: ui-monospace, monospace;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .cert-page-btn:hover {
    color: var(--text);
    border-color: rgba(0, 229, 255, 0.4);
    background: rgba(0, 229, 255, 0.08);
  }
  .cert-page-btn.active {
    color: #ffffff;
    background: rgba(0, 229, 255, 0.25);
    border-color: var(--accent);
    box-shadow: 0 0 15px -2px rgba(0, 229, 255, 0.4);
  }

  /* Modal Dialog */
  .cert-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(2, 6, 23, 0.86);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
  }
  .cert-modal-backdrop[hidden] {
    display: none !important;
  }
  .cert-modal-backdrop.modal-open {
    opacity: 1;
    pointer-events: auto;
  }
  .cert-modal-backdrop.modal-closing {
    opacity: 0;
    pointer-events: none;
  }

  .cert-modal-container {
    position: relative;
    width: 100%;
    max-width: 1140px;
    background: #0b1120;
    border: 1px solid rgba(0, 229, 255, 0.35);
    border-radius: 1.5rem;
    box-shadow:
      0 25px 60px -15px rgba(0, 0, 0, 0.8),
      0 0 40px -10px rgba(0, 229, 255, 0.25);
    overflow: hidden;
    transform: scale(0.96);
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cert-modal-backdrop.modal-open .cert-modal-container {
    transform: scale(1);
  }

  .cert-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: #94a3b8;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.2);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .cert-modal-close:hover {
    color: #ffffff;
