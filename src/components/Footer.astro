---
import {
  getPersonalData,
  getSiteData,
  getMenuData,
  useTranslations,
  type Locale,
  DEFAULT_LOCALE,
} from '../lib/i18n';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

const personalData = getPersonalData(lang);
const siteData = getSiteData(lang);
const menuData = getMenuData(lang);
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const navLinks = menuData.sections.map((s) => ({ label: s.label, href: s.href }));

const { footerAttribution } = siteData;
---

<footer
  id="site-footer"
  style="position: relative; background: var(--footer-bg); border-top: 1px solid var(--footer-border);"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl py-14">
    <div class="footer-grid">
      <div class="footer-left">
        <div>
          <p class="text-xl font-bold gradient-text">{personalData.name}</p>
          <p class="text-slate-500 text-xs mt-1.5 leading-relaxed max-w-[260px]">
            {siteData.tagline}
          </p>
          <a href={`mailto:${personalData.email}`} class="footer-email mt-3.5">
            <svg
              class="w-4 h-4 opacity-70 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>{personalData.email}</span>
          </a>
        </div>
      </div>

      <div class="footer-center">
        <nav class="flex flex-col gap-2" aria-label={t.footerNavAria}>
          {
            navLinks.map((link) => (
              <a href={link.href} class="footer-nav-link">
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="footer-right">
        <div class="flex flex-wrap gap-2">
          {siteData.seoKeywords.map((kw) => <span class="footer-kw">{kw}</span>)}
        </div>
      </div>
    </div>
    <div class="footer-divider my-8"></div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-slate-600 text-sm">
        © {currentYear}
        {personalData.name}
        {
          footerAttribution.builder && (
            <>
              {' '}
              · {lang === 'es' ? 'Basado en' : 'Based on'}{' '}
              <a href={footerAttribution.builderUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
                {footerAttribution.builder}
              </a>
            </>
          )
        }
        {
          footerAttribution.host && (
            <>
              {' '}
              / {lang === 'es' ? 'Alojado en' : 'Hosted on'}{' '}
              <a href={footerAttribution.hostUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
                {footerAttribution.host}
              </a>
            </>
          )
        }
        &nbsp;·&nbsp;<a href={`${base}privacy.html`} class="hover:text-accent transition-colors">{t.footerPrivacy}</a 
        >&nbsp;·&nbsp;<a href={`${base}terms.html`} class="hover:text-accent transition-colors">{t.footerTerms}</a> 
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: auto 1fr auto;
      gap: 3rem;
    }
  }

  .footer-left {
    display: flex;
    flex-direction: column;
  }
  .footer-center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .footer-right {
    text-align: right;
  }

  @media (max-width: 767px) {
    .footer-center {
      text-align: left;
      align-items: flex-start;
    }
    .footer-right {
      text-align: left;
    }
  }

  .footer-nav-link {
    color: #64748b;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s ease;
    position: relative;
    display: inline-block;
  }
  .footer-nav-link::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, #00e5ff, #2563eb);
    transition: width 0.3s ease;
  }
  .footer-nav-link:hover {
    color: #38bdf8;
  }
  .footer-nav-link:hover::after {
    width: 100%;
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #94a3b8;
    font-size: 0.825rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .footer-email:hover {
    color: #38bdf8;
  }

  .footer-kw {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: #cbd5e1;
    background: rgba(0, 229, 255, 0.06);
    border: 1px solid rgba(0, 229, 255, 0.2);
    border-radius: 9999px;
    padding: 0.2rem 0.65rem;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
    cursor: default;
    display: inline-block;
  }
  .footer-kw:hover {
    color: #00e5ff;
    border-color: rgba(0, 229, 255, 0.4);
  }

  .footer-divider {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 229, 255, 0.35) 25%,
      rgba(37, 99, 235, 0.35) 75%,
      transparent 100%
    );
  }

  [data-theme='light'] .footer-email {
    color: var(--text-dim);
  }
  [data-theme='light'] .footer-email:hover {
    color: var(--accent);
  }
  [data-theme='light'] .footer-kw {
    color: #0284c7;
    background: rgba(2, 132, 199, 0.08);
    border-color: rgba(2, 132, 199, 0.25);
  }
  [data-theme='light'] .footer-kw:hover {
    color: #0369a1;
    border-color: rgba(2, 132, 199, 0.45);
  }
  [data-theme='light'] .footer-nav-link {
    color: var(--text-dim);
  }
  [data-theme='light'] .footer-nav-link:hover {
    color: var(--accent);
  }
</style>
