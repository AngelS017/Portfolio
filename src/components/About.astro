---
import personalData from '../data/personal.json';

const educationList = [
  {
    degree: 'Máster Universitario en Inteligencia Artificial',
    institution: 'Universidad Politécnica de Madrid (UPM)',
    period: '2024 – Actualidad'
  },
  {
    degree: 'Grado en Ingeniería Informática',
    institution: 'Universidad Pública de Navarra (UPNA)',
    period: '2018 – 2024'
  },
  {
    degree: 'Estancia Académica Internacional (Beca Erasmus+)',
    institution: 'Grenoble INP · Institut Polytechnique de Grenoble (Francia)',
    period: '2023'
  },
  {
    degree: 'Diploma de Especialización en Desarrollo de Videojuegos y Realidad Virtual',
    institution: 'Universidad Pública de Navarra (UPNA)',
    period: '2018 – 2023'
  }
];

const pillars = [
  {
    title: 'Machine Learning & Deep Learning',
    desc: 'Modelado predictivo, redes neuronales y análisis avanzado de datos.',
    tools: ['PyTorch', 'Keras', 'Scikit-Learn', 'NumPy', 'Pandas'],
    icon: 'brain'
  },
  {
    title: 'Reinforcement Learning & Optimización',
    desc: 'Agentes inteligentes, simulación de entornos y algoritmos de optimización.',
    tools: ['DQN / PPO', 'PyTorch', 'Ray Tune', 'Pymgrid', 'Metaheurísticas'],
    icon: 'target'
  },
  {
    title: 'Lenguajes de Programación',
    desc: 'Computación científica, algoritmia eficiente y desarrollo de software robusto.',
    tools: ['Python', 'R', 'C', 'Java'],
    icon: 'code'
  },
  {
    title: 'Sistemas & Entornos de Desarrollo',
    desc: 'Gestión de entornos operativos, control de versiones y automatización de flujos.',
    tools: ['Linux', 'Windows', 'Git', 'Bash'],
    icon: 'settings'
  }
];
---

<section
  id="about"
  class="pt-6 pb-20 sm:pt-8 sm:pb-24"
  style="background: var(--bg-section); scroll-margin-top: 64px;"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-8 sm:mb-10 reveal">
        <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-2">
          Conóceme · Trayectoria & Enfoque
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">
          Sobre Mí
        </h2>
      </div>

      <!-- Bento Grid Layout: Option 1 -->
      <div class="space-y-6 sm:space-y-8">
        <!-- Top Tier: 2 Equal-Height Columns (Presentation & Academic Timeline) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
          <!-- Card 1: Story / Presentation -->
          <article class="about-card reveal h-full flex flex-col justify-between" style="transition-delay: 0.1s;">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <span class="about-card-badge">Presentación</span>
                <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
                  Ingeniero en Inteligencia Artificial y Machine Learning
                </h3>
              </div>

              <div class="space-y-4 text-slate-300 text-sm sm:text-base leading-relaxed">
                <p>
                  Soy <strong class="text-white font-semibold">{personalData.name}</strong>, afincado en {personalData.location}. Mi enfoque une un sólido <strong class="text-white font-semibold">dominio matemático y algorítmico</strong> con una arquitectura de software rigurosa, lo que me permite comprender en profundidad el funcionamiento de los modelos, evaluar críticamente su desempeño y explicar sus decisiones con transparencia <span class="text-slate-400 italic">(o hasta donde los modelos nos dejen y las matemáticas no nos vuelvan locos)</span>.
                </p>
                <p>
                  Con una firme base académica en <strong class="text-white font-semibold">Inteligencia Artificial y Computación</strong>, centro mi trabajo en el modelado avanzado de datos, el entrenamiento e interpretabilidad de redes neuronales profundas (Deep Learning) y el diseño de agentes autónomos mediante Aprendizaje por Refuerzo.
                </p>
                <div class="about-manifesto-quote p-4 rounded-xl mt-4">
                  <p class="text-xs sm:text-sm italic leading-relaxed text-slate-200">
                    «Para mí, la inteligencia artificial no es una caja negra: dominar sus fundamentos matemáticos es esencial para comprender qué ocurre bajo el capó, evaluar el comportamiento de los modelos más allá de métricas superficiales y explicar sus resultados de forma transparente y fundamentada.»
                  </p>
                </div>
              </div>
            </div>

            <!-- Clean Bottom Stats / Highlights Bar -->
            <div class="mt-6 pt-5 border-t border-slate-700/40 grid grid-cols-3 gap-2 text-center">
              <div class="p-2">
                <div class="text-base sm:text-lg font-bold text-white">IA & ML</div>
                <div class="text-[11px] text-slate-400 font-medium">Especialización</div>
              </div>
              <div class="p-2 border-x border-slate-700/30">
                <div class="text-base sm:text-lg font-bold text-white">UPM · UPNA</div>
                <div class="text-[11px] text-slate-400 font-medium">Formación Oficial</div>
              </div>
              <div class="p-2">
                <div class="text-base sm:text-lg font-bold text-white">Madrid</div>
                <div class="text-[11px] text-slate-400 font-medium">Ubicación</div>
              </div>
            </div>
          </article>

          <!-- Card 2: Academic Timeline (No nested boxes) -->
          <article class="about-card reveal h-full flex flex-col" style="transition-delay: 0.15s;">
            <div class="flex items-center gap-3 mb-3 sm:mb-4">
              <span class="about-card-badge">Académico</span>
              <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
                Educación Universitaria Oficial
              </h3>
            </div>

            <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-5">
              Base formal en Ingeniería Informática con especialización de posgrado en Inteligencia Artificial, complementada con formación internacional.
            </p>

            <!-- Fluid Academic Timeline without nested boxes -->
            <div class="about-timeline relative pl-6 space-y-6 flex-1 flex flex-col justify-between">
              {educationList.map((item) => (
                <div class="about-timeline-item relative">
                  <span class="about-timeline-dot" aria-hidden="true"></span>
                  <div class="flex items-start justify-between gap-2 mb-2.5 sm:mb-3">
                    <h4 class="text-sm sm:text-base font-semibold text-white flex-1 min-w-0">
                      {item.degree}
                    </h4>
                    <span class="education-period text-[11px] font-semibold shrink-0 mt-0.5">
                      {item.period}
                    </span>
                  </div>
                  <p class="text-xs sm:text-[13px] font-medium text-highlight">
                    {item.institution}
                  </p>
                </div>
              ))}
            </div>
          </article>
        </div>

        <!-- Bottom Tier: Technical Specializations in 4 Equal-Height Columns -->
        <div class="reveal" style="transition-delay: 0.25s;">
          <div class="flex items-center gap-3 mb-5 mt-2">
            <span class="about-card-badge">Especialización</span>
            <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Áreas de Enfoque Técnico
            </h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 items-stretch">
            {pillars.map((p) => (
              <div class="about-pillar-card h-full flex flex-col">
                <div class="pillar-card-top mb-3 shrink-0">
                  <div class="pillar-card-header flex items-start gap-3 mb-2.5">
                    <div class="pillar-icon-box shrink-0">
                      {p.icon === 'brain' && (
                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                        </svg>
                      )}
                      {p.icon === 'target' && (
                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <circle cx="12" cy="12" r="9" stroke-width="2" />
                          <circle cx="12" cy="12" r="5" stroke-width="2" />
                          <circle cx="12" cy="12" r="1" fill="currentColor" />
                        </svg>
                      )}
                      {p.icon === 'settings' && (
                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                      )}
                      {p.icon === 'code' && (
                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                        </svg>
                      )}
                    </div>
                    <h4 class="pillar-card-title text-[15px] sm:text-base font-bold text-white tracking-tight leading-snug pt-0.5">
                      {p.title}
                    </h4>
                  </div>
                  <p class="pillar-card-desc text-[13px] text-slate-300 leading-relaxed">
                    {p.desc}
                  </p>
                </div>
                <div class="pillar-tags-section flex-1 flex flex-col pt-3 border-t border-slate-700/40">
                  <div class="flex flex-wrap gap-1.5">
                    {p.tools.map((t) => (
                      <span class="tag pillar-tag">{t}</span>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .about-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    padding: 1.75rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .about-card:hover {
    border-color: rgba(99, 102, 241, 0.4);
    box-shadow:
      0 12px 40px -10px rgba(0, 0, 0, 0.4),
      0 0 25px -5px rgba(99, 102, 241, 0.15);
  }

  .about-card-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.28);
    border-radius: 9999px;
    padding: 0.2rem 0.65rem;
    line-height: 1.2;
    display: inline-block;
  }

  .about-manifesto-quote {
    background: rgba(99, 102, 241, 0.08);
    border-left: 3px solid var(--accent);
  }

  /* Academic Timeline (no nested boxes) */
  .about-timeline {
    border-left: 2px solid rgba(99, 102, 241, 0.25);
  }
  .about-timeline-dot {
    position: absolute;
    left: calc(-1.5rem - 5px);
    top: 5px;
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: var(--accent);
    border: 2px solid var(--bg-card-solid);
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.6);
  }

  .education-period {
    color: var(--accent);
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 9999px;
    padding: 0.15rem 0.55rem;
    line-height: 1.2;
  }

  /* Pillars modular card */
  .about-pillar-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    padding: 1.5rem 1.35rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .about-pillar-card:hover {
    border-color: rgba(99, 102, 241, 0.45);
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(99, 102, 241, 0.15);
  }

  .pillar-card-header {
    min-height: 44px;
    align-items: flex-start;
  }

  .pillar-card-desc {
    min-height: 40px;
  }

  @media (min-width: 640px) {
    .pillar-card-header {
      min-height: 4.75rem;
    }
    .pillar-card-desc {
      min-height: 4.25rem;
    }
  }

  .pillar-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 0.65rem;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.25);
  }

  .pillar-tag {
    font-size: 0.68rem;
    font-weight: 600;
    color: #a5b4fc;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.28);
    border-radius: 9999px;
    padding: 0.2rem 0.6rem;
    line-height: 1.2;
    transition: all 0.2s ease;
  }
  .pillar-tag:hover {
    color: #ffffff;
    background: rgba(99, 102, 241, 0.22);
    border-color: rgba(99, 102, 241, 0.5);
  }

  /* Light Theme Overrides */
  [data-theme='light'] .about-card {
    background: var(--bg-card);
    border-color: var(--border);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }
  [data-theme='light'] .about-card:hover {
    border-color: rgba(99, 102, 241, 0.45);
    box-shadow: 0 12px 32px rgba(99, 102, 241, 0.12);
  }
  [data-theme='light'] .about-card h3,
  [data-theme='light'] .about-card h4,
  [data-theme='light'] .about-card .text-white {
    color: var(--text) !important;
  }
  [data-theme='light'] .about-card strong {
    color: var(--text) !important;
  }
  [data-theme='light'] .about-card p {
    color: var(--text-muted);
  }
  [data-theme='light'] .about-card .text-slate-300 {
    color: var(--text-muted) !important;
  }
  [data-theme='light'] .about-card .text-slate-400 {
    color: var(--text-dim) !important;
  }
  [data-theme='light'] .about-card-badge {
    color: #4f46e5;
    background: rgba(99, 102, 241, 0.08);
    border-color: rgba(99, 102, 241, 0.25);
  }
  [data-theme='light'] .about-manifesto-quote {
    background: rgba(99, 102, 241, 0.05) !important;
    border-left-color: #4f46e5 !important;
  }
  [data-theme='light'] .about-manifesto-quote p {
    color: #334155 !important;
  }
  [data-theme='light'] .about-timeline {
    border-left-color: rgba(99, 102, 241, 0.25) !important;
  }
  [data-theme='light'] .about-timeline-dot {
    background: #4f46e5 !important;
    border-color: #ffffff !important;
    box-shadow: 0 0 8px rgba(79, 70, 229, 0.4) !important;
  }
  [data-theme='light'] .education-period {
    color: #4f46e5;
    background: rgba(99, 102, 241, 0.08);
    border-color: rgba(99, 102, 241, 0.25);
  }
  [data-theme='light'] .about-pillar-card {
    background: #ffffff !important;
    border: 1px solid rgba(99, 102, 241, 0.2) !important;
    box-shadow: 0 2px 10px rgba(99, 102, 241, 0.04) !important;
  }
  [data-theme='light'] .about-pillar-card:hover {
    background: #ffffff !important;
    border-color: rgba(99, 102, 241, 0.5) !important;
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.12) !important;
  }
  [data-theme='light'] .about-pillar-card h4 {
    color: #1e293b !important;
  }
  [data-theme='light'] .about-pillar-card p {
    color: #475569 !important;
  }
  [data-theme='light'] .pillar-icon-box {
    background: rgba(99, 102, 241, 0.1) !important;
    border: 1px solid rgba(99, 102, 241, 0.25) !important;
    color: #4f46e5 !important;
  }
  [data-theme='light'] .pillar-tag {
    color: #4338ca !important;
    background: rgba(67, 56, 202, 0.08) !important;
    border: 1px solid rgba(67, 56, 202, 0.25) !important;
  }
  [data-theme='light'] .border-slate-700\/40,
  [data-theme='light'] .border-slate-700\/30 {
    border-color: rgba(203, 213, 225, 0.6) !important;
  }
</style>

<script>
  document.querySelectorAll('#about .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    io.observe(el);
  });
</script>
