---
import {
  getPersonalData,
  useTranslations,
  type Locale,
  DEFAULT_LOCALE,
} from '../lib/i18n';
import { getSocialLinks } from '../lib/socialLinks';
import { withBase } from '../lib/assetPath';
import { existsSync, readdirSync } from 'node:fs';
import { extname, join } from 'node:path';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

const personalData = getPersonalData(lang);
const t = useTranslations(lang);

const heroSocialLinks = getSocialLinks(
  personalData as unknown as Record<string, string | string[]>,
  personalData.heroSocialLinks
);

// Split "Frontend & Backend" so the "&" can be styled with a different colour in the template.
const heroParts = personalData.heroRole.split(' & ');

// CV auto-discovery: check personalData.cv first (external URL or local path),
// then fall back to scanning public/cv/ for any PDF/DOC/DOCX file.
const cvValue = (personalData.cv ?? '').trim();
const isExternalCv = /^https?:\/\//i.test(cvValue);
const hasLocalCv =
  cvValue.startsWith('/') &&
  existsSync(join(process.cwd(), 'public', cvValue.replace(/^\//, '')));

let discoveredCv = '';
const cvPublicDir = join(process.cwd(), 'public', 'cv');
if (!isExternalCv && !hasLocalCv && existsSync(cvPublicDir)) {
  const allowedCvExt = new Set(['.pdf', '.doc', '.docx']);
  const candidates = readdirSync(cvPublicDir)
    .filter((f) => allowedCvExt.has(extname(f).toLowerCase()))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));
  if (candidates.length > 0) discoveredCv = `/cv/${candidates[0]}`;
}

const cvHref = (isExternalCv ? cvValue : hasLocalCv ? cvValue : discoveredCv) || '/cv/cv.pdf';

const photoValue = (personalData.photo ?? '').trim();
const isExternalPhoto = /^https?:\/\//i.test(photoValue);

let resolvedPhoto = photoValue;
let hasPortrait = false;

if (isExternalPhoto) {
  hasPortrait = true;
} else if (photoValue) {
  const localRelative = photoValue.replace(/^\//, '');
  const localFullPath = join(process.cwd(), 'public', localRelative);
  if (existsSync(localFullPath)) {
    hasPortrait = true;
  } else {
    // Fallback: If specified extension isn't found (e.g. .png vs .jpg), search common formats
    const ext = extname(localRelative);
    const basePath = ext ? localRelative.slice(0, -ext.length) : localRelative;
    for (const altExt of ['.jpg', '.jpeg', '.png', '.webp', '.avif']) {
      if (existsSync(join(process.cwd(), 'public', `${basePath}${altExt}`))) {
        resolvedPhoto = `/${basePath}${altExt}`;
        hasPortrait = true;
        break;
      }
    }
  }
}
---

<section id="home" class="relative min-h-screen overflow-hidden pt-16 sm:pt-18 pb-6 sm:pb-8 flex flex-col justify-start" style="background: var(--bg-section);">
  <div class="spotlight-bg" aria-hidden="true">
    <div class="spotlight spotlight-1"></div>
    <div class="spotlight spotlight-2"></div>
    <div class="spotlight spotlight-3"></div>
  </div>

  <div
    class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full opacity-20 animate-pulse-slow pointer-events-none"
    style="background: radial-gradient(circle, rgba(37,99,235,0.4) 0%, transparent 70%); filter: blur(40px); z-index: 1;"
  >
  </div>
  <div
    class="absolute bottom-1/4 left-1/4 w-96 h-96 rounded-full opacity-[0.15] animate-pulse-slow pointer-events-none"
    style="background: radial-gradient(circle, rgba(0,229,255,0.4) 0%, transparent 70%); filter: blur(40px); z-index: 1; animation-delay: 2s;"
  >
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-2 sm:pt-3">
    <div
      id="hero-canvas-wrapper"
      class="absolute overflow-hidden rounded-3xl pointer-events-none"
      style="inset: -6%; z-index: 0; opacity: 0.4; mask-image: radial-gradient(ellipse 88% 88% at 50% 50%, black 45%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 88% 88% at 50% 50%, black 45%, transparent 100%);"
    >
      <canvas id="hero-canvas" style="display:block;width:100%;height:100%;"></canvas>
    </div>

    <div class="max-w-6xl mx-auto">
      <!-- Hero Panoramic Brand Banner (Sleek Visual Header) -->
      <div class="hero-top-banner reveal mb-5 sm:mb-6 lg:mb-7" style="transition-delay: 0.1s;">
        <div class="hero-top-banner-glow" aria-hidden="true"></div>
        <div class="hero-top-banner-frame">
          <img
            src={withBase('/images/personal/ai-vision-banner.png')}
            alt={lang === 'en' ? 'Ángel Sanz Gutiérrez - AI and Machine Learning Banner' : 'Ángel Sanz Gutiérrez - Banner de Inteligencia Artificial y Machine Learning'}
            class="hero-top-banner-img"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="1024"
            height="489"
          />
        </div>
      </div>

      <div
        class={`grid grid-cols-1 ${hasPortrait ? 'lg:grid-cols-12' : ''} gap-8 lg:gap-10 xl:gap-12 items-center lg:items-start`}
      >
        <div class="lg:col-span-7 space-y-4 sm:space-y-5 relative max-w-xl">
          <div class="reveal text-backdrop" style="transition-delay: 0.1s;">
            <h1 class="font-bold leading-tight" style="font-size: clamp(2.2rem, 4vw, 3.75rem);">
              {t.greeting}<br />
              <span class="gradient-text">{personalData.name}</span>
            </h1>

            <h2 class="text-slate-400 font-light mt-2" style="font-size: clamp(1rem, 1.8vw, 1.35rem);">
              {
                heroParts.length > 1 ? (
                  <>
                    {heroParts[0]}{' '}<span class="text-highlight">&</span>{' '} 
                    {heroParts.slice(1).join(' & ')}
                  </>
                ) : (
                  heroParts[0]
                )
              }
            </h2>
          </div>

          <p
            class="text-sm sm:text-base text-slate-400 max-w-lg leading-relaxed reveal text-backdrop"
            style="transition-delay: 0.2s;"
          >
            {personalData.bio}
          </p>

          <div class="flex flex-col sm:flex-row gap-3.5 reveal" style="transition-delay: 0.25s;">
            <a href="#contact" class="btn-primary text-center">{t.contactBtn}</a>
            <a
              href={cvHref}
              download
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary text-center">{t.cvBtn}</a>
          </div>

          <div class="hero-social-container reveal" style="transition-delay: 0.3s;">
            {
              heroSocialLinks.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hero-social-circle"
                  data-platform={link.label.toLowerCase()}
                  aria-label={link.label}
                  title={link.label}
                >
                  <iconify-icon icon={link.icon} width="22" height="22" aria-hidden="true" />
                </a>
              ))
            }
          </div>
        </div>

        {hasPortrait && (
          <div class="lg:col-span-5 hero-portrait-wrapper reveal" style="transition-delay: 0.25s;">
            <div class="hero-portrait-card">
              <div class="hero-portrait-glow" aria-hidden="true"></div>
              <img
                src={withBase(resolvedPhoto)}
                alt={personalData.photoAlt ?? personalData.name}
                class="hero-portrait-img"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="400"
                height="460"
              />
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hero-social-container {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero-social-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.125rem;
    height: 3.125rem;
    border-radius: 50%;
    color: #cbd5e1;
    background: rgba(30, 41, 59, 0.55);
    border: 1.5px solid rgba(148, 163, 184, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }

  .hero-social-circle iconify-icon {
    font-size: 1.5rem;
    transition: transform 0.25s ease;
  }

  .hero-social-circle:hover {
    color: #ffffff;
    transform: translateY(-3px) scale(1.06);
  }

  .hero-social-circle[data-platform="github"]:hover {
    background: rgba(30, 41, 59, 0.9);
    border-color: rgba(255, 255, 255, 0.6);
    box-shadow: 0 8px 22px rgba(255, 255, 255, 0.15);
  }

  .hero-social-circle[data-platform="linkedin"]:hover {
    background: rgba(14, 165, 233, 0.15);
    border-color: rgba(14, 165, 233, 0.75);
    box-shadow: 0 8px 22px rgba(14, 165, 233, 0.3);
    color: #38bdf8;
  }

  .hero-social-circle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Light theme */
  [data-theme='light'] .hero-social-circle {
    color: #475569 !important;
    background: #ffffff !important;
    border: 1.5px solid rgba(203, 213, 225, 0.85) !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04) !important;
  }

  [data-theme='light'] .hero-social-circle:hover {
    color: #0f172a !important;
    background: #ffffff !important;
    border-color: #0284c7 !important;
    box-shadow: 0 6px 18px rgba(2, 132, 199, 0.18) !important;
  }

  [data-theme='light'] .hero-social-circle[data-platform="github"]:hover {
    border-color: #0f172a !important;
    color: #0f172a !important;
  }

  [data-theme='light'] .hero-social-circle[data-platform="linkedin"]:hover {
    border-color: #0284c7 !important;
    color: #0284c7 !important;
  }

  [data-theme='light'] #home h1 {
    color: #0f172a !important;
  }
  [data-theme='light'] #home h2.text-slate-400 {
    color: #475569 !important;
  }
  [data-theme='light'] #home p.text-slate-400 {
    color: #334155 !important;
  }
  [data-theme='light'] #hero-canvas-wrapper,
  [data-theme='light'] #home .spotlight-bg,
  [data-theme='light'] #home .animate-pulse-slow {
    display: none !important;
  }

  .spotlight-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .spotlight {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .spotlight-1 {
    width: 90vw;
    height: 90vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.12) 0%, transparent 65%);
    filter: blur(24px);
    animation: drift-1 22s ease-in-out infinite alternate;
  }

  .spotlight-2 {
    width: 70vw;
    height: 70vw;
    max-width: 700px;
    max-height: 700px;
    background: radial-gradient(circle, rgba(0, 229, 255, 0.09) 0%, transparent 65%);
    filter: blur(36px);
    animation: drift-2 28s ease-in-out infinite alternate;
  }

  .spotlight-3 {
    width: 40vw;
    height: 40vw;
    max-width: 400px;
    max-height: 400px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.09) 0%, transparent 60%);
    filter: blur(12px);
    animation: drift-3 18s ease-in-out infinite alternate;
  }

  @keyframes drift-1 {
    0% {
      transform: translate(-20%, -10%);
      opacity: 0.5;
    }
    25% {
      transform: translate(40%, 10%);
      opacity: 1;
    }
    50% {
      transform: translate(60%, 50%);
      opacity: 0.6;
    }
    75% {
      transform: translate(10%, 70%);
      opacity: 0.9;
    }
    100% {
      transform: translate(-10%, 40%);
      opacity: 0.4;
    }
  }

  @keyframes drift-2 {
    0% {
      transform: translate(80%, 60%);
      opacity: 0.6;
    }
    33% {
      transform: translate(10%, 80%);
      opacity: 1;
    }
    66% {
      transform: translate(-10%, 20%);
      opacity: 0.5;
    }
    100% {
      transform: translate(70%, -10%);
      opacity: 0.8;
    }
  }

  @keyframes drift-3 {
    0% {
      transform: translate(50%, 20%);
      opacity: 0.3;
    }
    40% {
      transform: translate(80%, 60%);
      opacity: 0.8;
    }
    70% {
      transform: translate(20%, 80%);
      opacity: 0.4;
    }
    100% {
      transform: translate(60%, 10%);
      opacity: 0.9;
    }
  }

  .text-backdrop {
    position: relative;
    z-index: 2;
    background: rgba(2, 6, 23, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 0.6rem;
    padding: 0.75rem 1rem;
    border-left: 2px solid rgba(96, 165, 250, 0.1);
  }

  [data-theme='light'] .text-backdrop {
    background: transparent !important;
    border: none !important;
    border-left: none !important;
    padding: 0 !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    box-shadow: none !important;
  }

  /* Hero Top Panoramic Banner (LinkedIn / GitHub Cover Style) */
  .hero-top-banner {
    position: relative;
    width: 100%;
  }

  .hero-top-banner-glow {
    position: absolute;
    inset: -10px;
    border-radius: 1.75rem;
    background: radial-gradient(ellipse at 50% 50%, rgba(0, 229, 255, 0.22) 0%, rgba(37, 99, 235, 0.12) 50%, transparent 75%);
    filter: blur(24px);
    z-index: 0;
    pointer-events: none;
    opacity: 0.7;
    transition: opacity 0.4s ease;
  }

  .hero-top-banner:hover .hero-top-banner-glow {
    opacity: 1;
  }

  .hero-top-banner-frame {
    position: relative;
    z-index: 1;
    border-radius: 1rem;
    overflow: hidden;
    background: #060d1a;
    border: 1px solid rgba(0, 229, 255, 0.32);
    box-shadow:
      0 12px 28px -8px rgba(0, 0, 0, 0.6),
      0 0 24px -4px rgba(0, 229, 255, 0.2);
    height: clamp(165px, 20vw, 230px);
    width: 100%;
    transition:
      border-color 0.3s ease,
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.4s ease;
  }

  .hero-top-banner-frame:hover {
    transform: translateY(-2px);
    border-color: rgba(0, 229, 255, 0.55);
    box-shadow:
      0 18px 36px -8px rgba(0, 0, 0, 0.7),
      0 0 36px rgba(0, 229, 255, 0.32);
  }

  .hero-top-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    display: block;
    transition: transform 0.6s ease;
  }

  .hero-top-banner-frame:hover .hero-top-banner-img {
    transform: scale(1.025);
  }

  /* Light mode for hero top banner */
  [data-theme='light'] .hero-top-banner-frame {
    background: #ffffff;
    border-color: rgba(2, 132, 199, 0.32);
    box-shadow:
      0 12px 30px -8px rgba(2, 132, 199, 0.14),
      0 0 20px rgba(2, 132, 199, 0.1);
  }

  [data-theme='light'] .hero-top-banner-frame:hover {
    border-color: rgba(2, 132, 199, 0.6);
    box-shadow:
      0 16px 36px -8px rgba(2, 132, 199, 0.2),
      0 0 30px rgba(2, 132, 199, 0.16);
  }

  /* Hero Portrait Container & Alignment */
  .hero-portrait-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    align-self: center;
  }

  @media (min-width: 1024px) {
    .hero-portrait-wrapper {
      justify-content: flex-end;
      align-self: flex-start;
      margin-top: 0.15rem;
    }
  }

  /* Hero Portrait Card */
  .hero-portrait-card {
    position: relative;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    border-radius: 1.5rem;
    padding: 0.5rem;
    background: linear-gradient(135deg, rgba(0, 229, 255, 0.22) 0%, rgba(37, 99, 235, 0.14) 100%);
    border: 1px solid rgba(0, 229, 255, 0.3);
    box-shadow:
      0 20px 45px -12px rgba(0, 0, 0, 0.65),
      0 0 35px -4px rgba(0, 229, 255, 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.4s ease;
  }

  .hero-portrait-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow:
      0 28px 50px -10px rgba(0, 0, 0, 0.75),
      0 0 45px 0px rgba(0, 229, 255, 0.4);
  }

  .hero-portrait-glow {
    position: absolute;
    inset: -10px;
    border-radius: 2rem;
    background: radial-gradient(circle, rgba(0, 229, 255, 0.32) 0%, rgba(37, 99, 235, 0.16) 50%, transparent 70%);
    filter: blur(16px);
    z-index: -1;
    pointer-events: none;
    opacity: 0.75;
    transition: opacity 0.4s ease;
  }

  .hero-portrait-card:hover .hero-portrait-glow {
    opacity: 1;
  }

  .hero-portrait-img {
    display: block;
    width: min(85vw, 290px);
    height: min(85vw, 345px);
    object-fit: cover;
    object-position: center 16%;
    border-radius: 1.15rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 640px) {
    .hero-portrait-img {
      width: 310px;
      height: 365px;
    }
  }

  @media (min-width: 1024px) {
    .hero-portrait-img {
      width: 360px;
      height: 420px;
    }
  }

  @media (min-width: 1280px) {
    .hero-portrait-img {
      width: 405px;
      height: 470px;
    }
  }

  [data-theme='light'] .hero-portrait-card {
    background: linear-gradient(135deg, rgba(2, 132, 199, 0.15) 0%, rgba(56, 189, 248, 0.08) 100%);
    border-color: rgba(2, 132, 199, 0.2);
    box-shadow:
      0 20px 40px -15px rgba(2, 132, 199, 0.15),
      0 0 25px 0px rgba(2, 132, 199, 0.12);
  }

  [data-theme='light'] .hero-portrait-img {
    border-color: rgba(2, 132, 199, 0.15);
  }
</style>

<script>
  document.querySelectorAll('#home .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.05 }
    );
    io.observe(el);
  });

  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const wrapper = document.getElementById('hero-canvas-wrapper') as HTMLElement | null;
  const section = document.getElementById('home') as HTMLElement | null;
  if (!canvas || !wrapper || !section) {
    console.error('Hero canvas init failed');
  } else {
    const ctx = canvas.getContext('2d')!;
    const BLOCK = 8; // fine grid cell size
    const DOT = 2; // dot diameter in px
    const COLOR_A = '#00e5ff';
    const COLOR_B = '#2563eb';
    const GRID_BG = '#09090b';
    const GRID_STROKE = '#111827';
    const DECAY = 1 / 14;

    let cols = 0,
      rows = 0;

    let timers = new Float32Array(0);

    function resize() {
      const w = wrapper!.offsetWidth;
      const h = wrapper!.offsetHeight;
      canvas!.width = w;
      canvas!.height = h;
      cols = Math.ceil(w / BLOCK) + 1;
      rows = Math.ceil(h / BLOCK) + 1;
      timers = new Float32Array(cols * rows);
    }

    function drawGrid() {
      ctx.fillStyle = GRID_BG;
      ctx.fillRect(0, 0, canvas!.width, canvas!.height);
      ctx.strokeStyle = GRID_STROKE;
      ctx.lineWidth = 0.4;
      for (let x = 0; x <= canvas!.width; x += BLOCK) {
        ctx.beginPath();
        ctx.moveTo(x + 0.5, 0);
        ctx.lineTo(x + 0.5, canvas!.height);
        ctx.stroke();
      }
      for (let y = 0; y <= canvas!.height; y += BLOCK) {
        ctx.beginPath();
        ctx.moveTo(0, y + 0.5);
        ctx.lineTo(canvas!.width, y + 0.5);
        ctx.stroke();
      }
    }

    function drawDot(col: number, row: number, t: number) {
      const cx = col * BLOCK + BLOCK / 2;
      const cy = row * BLOCK + BLOCK / 2;
      const color = (col + row) % 2 === 0 ? COLOR_A : COLOR_B;
      ctx.globalAlpha = t * 0.72;
      ctx.fillStyle = color;
      ctx.fillRect(Math.floor(cx - DOT / 2), Math.floor(cy - DOT / 2), DOT, DOT);
      ctx.globalAlpha = 1.0;
    }

    function animate() {
      drawGrid();
      for (let i = 0; i < timers.length; i++) {
        if (timers[i] > 0) {
          drawDot(i % cols, Math.floor(i / cols), timers[i]);
          timers[i] = Math.max(0, timers[i] - DECAY);
        }
      }
    }

    section.addEventListener('mousemove', (e: MouseEvent) => {
      if (mql.matches || !heroVisible) return;
      const rect = wrapper!.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      const cx = Math.floor(mx / BLOCK);
      const cy = Math.floor(my / BLOCK);
      const radius = 2;
      for (let dy = -radius; dy <= radius; dy++) {
        for (let dx = -radius; dx <= radius; dx++) {
          if (dx * dx + dy * dy > radius * radius) continue;
          const nx = cx + dx,
            ny = cy + dy;
          if (nx >= 0 && nx < cols && ny >= 0 && ny < rows) {
            const idx = ny * cols + nx;
            if (timers[idx] === 0) timers[idx] = 1.0;
          }
        }
      }
      startAnimation();
    });

    const ro = new ResizeObserver(() => resize());
    ro.observe(wrapper);
    resize();

    const mql = window.matchMedia('(prefers-reduced-motion: reduce)');
    let rafId = 0;
    let heroVisible = true;

    // Self-terminating loop: the rAF cycle stops as soon as all dot timers reach 0,
    // so the canvas draws nothing and burns no CPU when the user's cursor is idle.
    function startAnimation() {
      if (rafId !== 0) return;
      function loop() {
        animate();
        let anyActive = false;
        for (let i = 0; i < timers.length; i++) {
          if (timers[i] > 0) {
            anyActive = true;
            break;
          }
        }
        rafId = anyActive ? requestAnimationFrame(loop) : 0;
      }
      rafId = requestAnimationFrame(loop);
    }

    drawGrid();

    mql.addEventListener('change', (e: MediaQueryListEvent) => {
      if (e.matches) {
        cancelAnimationFrame(rafId);
        rafId = 0;
        drawGrid();
      }
    });

    new IntersectionObserver(
      ([entry]) => {
        heroVisible = entry.isIntersecting;
        if (!entry.isIntersecting) {
          cancelAnimationFrame(rafId);
          rafId = 0;
        }
      },
      { threshold: 0.05 }
    ).observe(section);
  }
</script>
