---
import {
  getProjectsData,
  getPersonalData,
  useTranslations,
  type Locale,
  DEFAULT_LOCALE,
} from '../lib/i18n';
import { augmentProjectsWithImages, type ProjectEntry } from '../lib/fetchGitHub';
import { withBase } from '../lib/assetPath';

interface Props {
  featuredOnly?: boolean;
  lang?: Locale;
}
const { featuredOnly = false, lang = DEFAULT_LOCALE } = Astro.props;

const projectsFile = getProjectsData(lang);
const personalData = getPersonalData(lang);
const t = useTranslations(lang);

const allProjectsData = await augmentProjectsWithImages(projectsFile.items as ProjectEntry[]);
const displayProjects = featuredOnly
  ? allProjectsData.filter((p) => p.featured)
  : allProjectsData;

const categoryFilters = [...new Set(allProjectsData.map((p) => p.category))].map((cat) => ({
  label: cat.replace(/\b\w/g, (c) => c.toUpperCase()),
  value: cat,
}));

const filters = [
  { label: t.filterFeatured, value: 'featured' },
  { label: t.filterAll, value: 'all' },
  ...categoryFilters,
];

const githubUser = personalData.github || 'AngelS017';

function getGitHubUrl(project: ProjectEntry) {
  if (project.githubRepo) {
    return `https://github.com/${githubUser}/${project.githubRepo}`;
  }
  if (project.link && project.link.includes('github.com')) {
    return project.link;
  }
  return `https://github.com/${githubUser}`;
}

function getProjectImage(project: ProjectEntry) {
  return (
    project.featuredImage ||
    project.backgroundImage ||
    '/images/projects/default-bg.jpg'
  );
}

const projectsJson = JSON.stringify(
  allProjectsData.map((p) => ({
    ...p,
    gitHubUrl: getGitHubUrl(p),
    projectImage: withBase(getProjectImage(p)),
    backgroundImage: p.backgroundImage ? withBase(p.backgroundImage) : p.backgroundImage,
  }))
);
---

<section id="projects" class="pt-6 pb-20 sm:pt-8 sm:pb-24" style="background: var(--bg-section); scroll-margin-top: 64px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8 sm:mb-10 reveal">
      <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-2">{t.projectsEyebrow}</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">{t.projectsTitle}</h2>
    </div>

    <div class="max-w-6xl mx-auto flex flex-wrap justify-center gap-2 mb-8 reveal" style="transition-delay:0.1s;">
      {
        filters.map((f) => (
          <button
            class="filter-btn"
            data-filter={f.value}
            aria-pressed={f.value === 'featured' ? 'true' : 'false'}
          >
            {f.label}
            <span class="filter-count" data-count={f.value} />
          </button>
        ))
      }
    </div>

    <div
      class="projects-scroll-container max-w-6xl mx-auto"
      id="projects-scroll-wrapper"
    >
      <div id="projects-grid" class="flex flex-col gap-5">
        {
          displayProjects.map((project, i) => (
            <article
              class="project-card-h reveal"
              data-category={project.category}
              data-featured={(project as any).featured ? 'true' : 'false'}
              data-index={i}
              style={`transition-delay: ${(i % 3) * 0.08}s;`}
              role="button"
              tabindex="0"
              aria-label={`${t.viewDetailsAria} ${project.title}`}
            >
              <!-- Left: Project Photo -->
              <div class="project-card-h-media">
                <img
                  src={withBase(getProjectImage(project))}
                  alt={project.title}
                  loading="lazy"
                  class="project-card-h-img"
                  width="360"
                  height="240"
                />
                <div class="project-card-h-glow" aria-hidden="true" />
              </div>

              <!-- Right: Info & Actions -->
              <div class="project-card-h-body">
                <div class="project-card-h-top">
                  <div>
                    <span class="project-category-badge mb-1.5 inline-block">
                      {project.category}
                    </span>
                    <h3 class="project-title text-xl sm:text-2xl font-bold leading-snug">
                      {project.title}
                    </h3>
                  </div>

                  <!-- GitHub Action Button -->
                  <a
                    href={getGitHubUrl(project)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-github-btn shrink-0"
                    aria-label={`${t.viewCodeAria} ${project.title}`}
                    title={t.viewRepoTitle}
                  >
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                    </svg>
                  </a>
                </div>

                <p class="project-desc leading-relaxed">
                  {project.description}
                </p>

                <div class="project-card-h-bottom">
                  <div class="flex flex-wrap items-center gap-1.5">
                    {project.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <p id="projects-empty" class="hidden text-center text-slate-600 text-sm mt-12">
      {t.projectsEmpty}
    </p>
  </div>
</section>

<div
  id="project-modal"
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  hidden
>
  <div class="modal-container" id="modal-container">
    <button class="modal-close" id="modal-close" aria-label={t.modalClose}>
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="modal-content-layout">
      <div class="modal-hero" id="modal-hero">
        <div class="modal-hero-overlay"></div>
      </div>

      <div class="modal-body">
        <div class="flex items-center justify-between gap-3 mb-2">
          <div id="modal-category-badge" class="modal-cat-badge"></div>
        </div>

        <h2 id="modal-title" class="modal-heading mb-3"></h2>
        <p id="modal-description" class="modal-description mb-4"></p>

        <h4 class="text-xs font-bold text-highlight uppercase tracking-wider mb-2">{t.modalTech}</h4>
        <div id="modal-tags" class="modal-tags mb-6"></div>

        <div class="modal-cta-wrap">
          <a id="modal-link" href="#" target="_blank" rel="noopener noreferrer" class="modal-cta-link">
            <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            <span id="modal-link-text">{t.modalGithub}</span>
            <svg class="modal-cta-arrow ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
              ></path>
            </svg>
          </a>
          <p id="modal-no-link" class="modal-no-link hidden">{t.modalPrivate}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- define:vars injects the server-rendered JSON blob as a JS variable in this inline script.
     is:inline is required alongside define:vars; without it Astro would bundle the script
     and the injected variable would not be in scope. -->
<script is:inline define:vars={{ projectsJson, gitHubLabel: t.modalGithub, viewProjectLabel: lang === 'es' ? 'Ver Proyecto' : 'View Project' }}>
  // @ts-nocheck
  const projects = JSON.parse(projectsJson);

  document.querySelectorAll('#projects .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.05 }
    );
    io.observe(el);
  });

  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card-h[data-category]');
  const empty = document.getElementById('projects-empty');
  let active = null;

  document.querySelectorAll('.filter-count').forEach((el) => {
    const cat = el.dataset.count;
    let n;
    if (cat === 'all') n = cards.length;
    else if (cat === 'featured') n = [...cards].filter((c) => c.dataset.featured === 'true').length;
    else n = [...cards].filter((c) => c.dataset.category === cat).length;
    el.textContent = `${n}`;
  });

  function applyFilter(filter) {
    if (filter === active) return;
    active = filter;
    filterBtns.forEach((b) => {
      const on = b.dataset.filter === filter;
      b.classList.toggle('filter-active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    let visible = 0;
    cards.forEach((card) => {
      const matches =
        filter === 'all' ||
        (filter === 'featured' && card.dataset.featured === 'true') ||
        card.dataset.category === filter;
      card.classList.remove('pf-enter');
      if (!matches) {
        card.classList.add('pf-hidden');
      } else {
        card.classList.remove('pf-hidden');
        card.style.setProperty('--enter-delay', `${visible * 0.05}s`);
        // Force a reflow so the browser registers the class removal before re-adding pf-enter.
        // Without this, the CSS animation does not restart when re-showing an already-visible card.
        void card.offsetWidth;
        card.classList.add('pf-enter');
        visible++;
      }
    });
    if (empty) empty.classList.toggle('hidden', visible > 0);
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter));
  });

  applyFilter('featured');
  document.querySelector('[data-filter="featured"]')?.classList.add('filter-active');

  const modal = document.getElementById('project-modal');
  const container = document.getElementById('modal-container');
  const closeBtn = document.getElementById('modal-close');
  const modalHero = document.getElementById('modal-hero');
  const modalCat = document.getElementById('modal-category-badge');
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-description');
  const modalTags = document.getElementById('modal-tags');
  const modalLink = document.getElementById('modal-link');
  const modalLinkTx = document.getElementById('modal-link-text');
  const modalNoLink = document.getElementById('modal-no-link');

  function openModal(idx) {
    const p = projects[idx];
    if (!p) return;

    const img = p.projectImage || p.backgroundImage || null;
    if (img) {
      modalHero.style.backgroundImage = `url('${img}')`;
      modalHero.style.display = '';
    } else {
      modalHero.style.backgroundImage = '';
      modalHero.style.display = 'none';
    }

    modalCat.textContent = p.category;
    modalTitle.textContent = p.title;
    modalDesc.textContent = p.fullDescription || p.description;

    modalTags.innerHTML = '';
    for (const t of p.tags) {
      const span = document.createElement('span');
      span.className = 'tag';
      span.textContent = t;
      modalTags.appendChild(span);
    }

    const targetUrl = p.gitHubUrl || p.link;
    if (targetUrl) {
      modalLink.href = targetUrl;
      modalLinkTx.textContent = targetUrl.includes('github.com') ? gitHubLabel : viewProjectLabel;
      modalLink.classList.remove('hidden');
      modalNoLink.classList.add('hidden');
    } else {
      modalLink.classList.add('hidden');
      modalNoLink.classList.remove('hidden');
    }

    // The `hidden` attribute (not a CSS class) is used here because the modal-backdrop rule
    // sets `display:none !important` on `[hidden]`, which gives correct AT (screen reader) semantics.
    modal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden'; // prevent page scroll while modal is open
    void container.offsetWidth;
    modal.classList.add('modal-open');
    closeBtn.focus();
  }

  function closeModal() {
    modal.classList.remove('modal-open');
    modal.classList.add('modal-closing');
    setTimeout(() => {
      modal.setAttribute('hidden', '');
      modal.classList.remove('modal-closing');
      document.body.style.overflow = '';
    }, 280);
  }

  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      if (e.target.closest('.project-github-btn')) return;
      openModal(parseInt(card.dataset.index, 10));
    });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openModal(parseInt(card.dataset.index, 10));
      }
    });
  });

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hasAttribute('hidden')) closeModal();
  });
</script>

<style is:global>
  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    background: var(--bg-section);
    border: 1px solid var(--border);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .filter-btn:hover {
    color: var(--text-muted);
    background: var(--bg-card);
    border-color: var(--border-hover);
    transform: translateY(-1px);
  }
  .filter-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .filter-btn.filter-active {
    color: var(--accent);
    background: rgba(0, 229, 255, 0.1);
    border-color: rgba(0, 229, 255, 0.35);
  }
  .filter-count {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-dimmer);
    background: var(--border);
    border-radius: 9999px;
    padding: 0 0.35rem;
    min-width: 1.1rem;
    text-align: center;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }
  .filter-btn.filter-active .filter-count {
    color: var(--accent);
    background: rgba(0, 229, 255, 0.18);
  }

  /* Scrollable Container */
  .projects-scroll-container {
    max-height: 760px;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.5rem 0.5rem 1rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 229, 255, 0.35) rgba(15, 23, 42, 0.4);
  }

  .projects-scroll-container::-webkit-scrollbar {
    width: 6px;
  }
  .projects-scroll-container::-webkit-scrollbar-track {
    background: rgba(15, 23, 42, 0.4);
    border-radius: 9999px;
  }
  .projects-scroll-container::-webkit-scrollbar-thumb {
    background: rgba(0, 229, 255, 0.35);
    border-radius: 9999px;
  }
  .projects-scroll-container::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 229, 255, 0.65);
  }

  /* Horizontal Project Card */
  .project-card-h {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition:
      transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      border-color 0.35s ease,
      box-shadow 0.35s ease;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  @media (min-width: 768px) {
    .project-card-h {
      flex-direction: row;
      align-items: stretch;
      min-height: 180px;
    }
  }

  .project-card-h:hover {
    transform: translateY(-4px) scale(1.008);
    border-color: rgba(0, 229, 255, 0.4);
    box-shadow:
      0 16px 40px -12px rgba(0, 0, 0, 0.5),
      0 0 30px -6px rgba(0, 229, 255, 0.2);
  }

  .project-card-h:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .project-card-h.pf-hidden {
    display: none;
  }

  .project-card-h.pf-enter {
    animation: card-enter 0.4s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0s) both;
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Photo on the Left */
  .project-card-h-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: rgba(2, 6, 23, 0.6);
  }

  @media (max-width: 767px) {
    .project-card-h-media {
      height: 180px;
    }
  }

  @media (min-width: 768px) {
    .project-card-h-media {
      width: 260px;
      min-width: 260px;
      max-width: 280px;
    }
  }

  @media (min-width: 1024px) {
    .project-card-h-media {
      width: 300px;
      min-width: 300px;
      max-width: 320px;
    }
  }

  .project-card-h-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .project-card-h:hover .project-card-h-img {
    transform: scale(1.06);
  }

  .project-card-h-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 60%, rgba(2, 6, 23, 0.6) 100%);
  }

  @media (min-width: 768px) {
    .project-card-h-glow {
      background: linear-gradient(90deg, transparent 75%, rgba(2, 6, 23, 0.6) 100%);
    }
  }

  /* Right: Body */
  .project-card-h-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 1.15rem 1.55rem;
    position: relative;
    z-index: 2;
  }

  .project-card-h-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.85rem;
    margin-bottom: 0.1rem;
  }

  .project-title {
    color: var(--text);
    transition: color 0.35s ease;
    letter-spacing: -0.01em;
  }

  .project-card-h:hover .project-title {
    color: var(--accent);
  }

  .project-desc {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0.2rem 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* GitHub Action Button */
  .project-github-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: #cbd5e1;
    background: rgba(30, 41, 59, 0.7);
    border: 1.5px solid rgba(148, 163, 184, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .project-github-btn:hover {
    color: #ffffff;
    background: rgba(30, 41, 59, 0.95);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-2px) scale(1.06);
    box-shadow: 0 6px 18px rgba(255, 255, 255, 0.15);
  }

  [data-theme='light'] .project-github-btn {
    color: #475569;
    background: rgba(255, 255, 255, 0.85);
    border-color: rgba(203, 213, 225, 0.85);
  }

  [data-theme='light'] .project-github-btn:hover {
    color: #0f172a;
    background: #ffffff;
    border-color: #0284c7;
    box-shadow: 0 6px 18px rgba(2, 132, 199, 0.2);
  }

  .project-category-badge {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #38bdf8;
    background: rgba(0, 229, 255, 0.1);
    border: 1px solid rgba(0, 229, 255, 0.28);
    border-radius: 9999px;
    padding: 0.18rem 0.55rem;
    line-height: 1.2;
    transition: all 0.25s ease;
  }
  .project-card-h:hover .project-category-badge {
    background: rgba(0, 229, 255, 0.22);
    border-color: rgba(0, 229, 255, 0.55);
    color: #ffffff;
  }
  [data-theme='light'] .project-category-badge {
    color: #0284c7;
    background: rgba(2, 132, 199, 0.08);
    border-color: rgba(2, 132, 199, 0.25);
  }
